# ─── Docker Environment (copy to .env for Docker usage) ───
APP_NAME=DonateBazaar
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=donatebazaar
DB_USERNAME=donatebazaar
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

CACHE_STORE=redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@donatebazaar.com
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

RAZORPAY_KEY=
RAZORPAY_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback

CLOUDINARY_URL=

TELESCOPE_ENABLED=true
DEBUGBAR_ENABLED=false

# ─── Build / Deploy ───
BUILD_TARGET=dev          # dev → includes xdebug + dev deps | base → production-optimized
NGINX_PORT=80
